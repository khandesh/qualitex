<%- include("partials/header") %>
<main>
  <section class="page-hero">
    <div class="container page-intro">
      <p class="eyebrow">NABL accreditation</p>
      <h1>Certificate extracts and scope highlights.</h1>
      <p>The uploaded certificate PDF is image-heavy, so this page now presents the key details as readable extracts instead of relying on an embedded PDF viewer.</p>
      <div class="actions">
        <a class="btn btn-primary" href="/documents/QTSPL-NABL-Details.pdf" target="_blank">Open Original PDF</a>
        <a class="btn" href="/services">View Testing Services</a>
      </div>
    </div>
  </section>

  <section class="section compact">
    <div class="container metrics-strip">
      <% (locals.capabilityHighlights || []).forEach((item) => { %>
        <div>
          <strong><%= item.value %></strong>
          <span><%= item.label %></span>
        </div>
      <% }) %>
    </div>
  </section>

  <section class="section">
    <div class="container extract-layout">
      <div class="section-heading">
        <p class="eyebrow">From the certificate</p>
        <h2>Key accreditation details.</h2>
        <p>These extracts are shown directly on the page for faster client review, while the original PDF remains available as a source document.</p>
      </div>
      <div class="extract-grid">
        <% (locals.certificateExtracts || []).forEach((item) => { %>
          <article class="extract-card">
            <span><%= item.label %></span>
            <strong><%= item.value %></strong>
          </article>
        <% }) %>
      </div>
    </div>
  </section>

  <section class="section feature-band dark">
    <div class="container split-layout">
      <div>
        <p class="eyebrow">Scope highlights</p>
        <h2>Readable scope summary for project teams.</h2>
        <p>Use this summary to quickly confirm the lab’s civil engineering testing focus before opening the full certificate document.</p>
      </div>
      <ul class="scope-list">
        <% (locals.certificateScopeExtracts || []).forEach((item) => { %>
          <li><%= item %></li>
        <% }) %>
      </ul>
    </div>
  </section>

  <section class="section equipment-section">
    <div class="container section-heading">
      <p class="eyebrow">Lab readiness</p>
      <h2>Equipment capability supporting the testing scope.</h2>
    </div>
    <div class="container gallery">
      <% (locals.galleryImages || []).forEach((image) => { %>
        <figure>
          <img src="/images/<%= image %>" alt="Qualitex testing equipment" loading="lazy" />
        </figure>
      <% }) %>
    </div>
  </section>
</main>
<%- include("partials/footer") %>
