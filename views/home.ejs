<%- include("partials/header") %>
<main>
  <section class="hero">
    <div class="hero-media slideshow" id="mixed-slideshow" data-autoplay="5200">
      <% (locals.mixedSlideshowImages || []).forEach((img, idx) => { %>
        <figure class="slide <%= idx === 0 ? 'active' : '' %>">
          <img src="/images/<%= img %>" alt="Qualitex laboratory and field testing work" />
        </figure>
      <% }) %>
      <div class="slide-controls" aria-label="Operations slideshow controls">
        <button class="icon-btn" type="button" data-slide-prev="mixed-slideshow" aria-label="Previous slide">‹</button>
        <button class="icon-btn" type="button" data-slide-next="mixed-slideshow" aria-label="Next slide">›</button>
      </div>
    </div>
    <div class="container hero-content">
      <p class="eyebrow">NABL accredited civil engineering testing laboratory</p>
      <h1>Precision Testing. Absolute <span>Trust.</span></h1>
      <p class="lead">Material testing, on-site sampling, and geotechnical support for infrastructure teams that need dependable results and clean documentation.</p>
      <div class="actions">
        <a class="btn btn-primary" href="/contact">Request Testing Support</a>
        <a class="btn btn-plain" href="/documents/QTSPL-NABL-Details.pdf" target="_blank">View NABL Details</a>
      </div>
    </div>
  </section>

  <section class="section compact">
    <div class="container metrics-strip">
      <% (locals.capabilityHighlights || []).forEach((item) => { %>
        <div>
          <strong><%= item.value %></strong>
          <span><%= item.label %></span>
        </div>
      <% }) %>
    </div>
  </section>

  <section class="section">
    <div class="container section-heading">
      <p class="eyebrow">Testing portfolio</p>
      <h2>Built for roads, buildings, plants, and public infrastructure.</h2>
      <p>Comprehensive construction material testing inspired by the needs of active sites: concrete, NDT, steel, soil, aggregates, bitumen, base-subbase materials, and chemical checks.</p>
    </div>
    <div class="container service-grid rich">
      <% (locals.serviceCategories || []).slice(0, 4).forEach((service) => { %>
        <article class="service-card service-card-rich">
          <span></span>
          <h3><%= service.title %></h3>
          <p><%= service.summary %></p>
        </article>
      <% }) %>
    </div>
    <div class="container" style="display: flex; justify-content: center; margin-top: 48px;">
      <a class="btn btn-muted" href="/services">View All Testing Services</a>
    </div>
  </section>

  <section id="site-visit" class="section feature-band dark">
    <div class="container feature-layout">
      <div>
        <p class="eyebrow">Site visit & sample collection</p>
        <h2>Field collection handled with the same discipline as lab testing.</h2>
        <p>Qualitex supports project teams with site visits, material sampling, geotechnical investigation support, concrete core handling, and documented collection workflows that protect sample integrity from source to report.</p>
        <div class="actions">
          <a class="btn btn-light" href="/contact">Schedule a Site Visit</a>
          <a class="btn btn-muted" href="/services">Explore Methods</a>
        </div>
      </div>
      <div class="media-frame slideshow" id="onsite-slideshow" data-autoplay="4300">
        <% (locals.onsiteImages || []).forEach((img, idx) => { %>
          <figure class="slide <%= idx === 0 ? 'active' : '' %>">
            <img src="/images/<%= img %>" alt="On-site sample collection and inspection" loading="lazy" />
          </figure>
        <% }) %>
        <div class="slide-controls">
          <button class="icon-btn light" type="button" data-slide-prev="onsite-slideshow" aria-label="Previous site visit image">‹</button>
          <button class="icon-btn light" type="button" data-slide-next="onsite-slideshow" aria-label="Next site visit image">›</button>
        </div>
      </div>
    </div>
  </section>

  <section id="equipment" class="section equipment-section">
    <div class="container feature-layout">
      <div class="media-frame slideshow" id="equipment-slideshow" data-autoplay="4500">
        <% (locals.equipmentImages || []).slice(0, 8).forEach((img, idx) => { %>
          <figure class="slide <%= idx === 0 ? 'active' : '' %>">
            <img src="/images/<%= img %>" alt="Testing equipment and machinery" loading="lazy" />
          </figure>
        <% }) %>
        <div class="slide-controls">
          <button class="icon-btn light" type="button" data-slide-prev="equipment-slideshow" aria-label="Previous equipment image">‹</button>
          <button class="icon-btn light" type="button" data-slide-next="equipment-slideshow" aria-label="Next equipment image">›</button>
        </div>
      </div>
      <div>
        <p class="eyebrow">Equipment & machineries</p>
        <h2>Calibrated machines, controlled processes, and traceable results.</h2>
        <p>Dedicated lab equipment supports repeatable testing for civil engineering materials, construction products, pavements, and infrastructure quality control.</p>
        <div class="actions">
          <a class="btn btn-muted" href="/services">View Capabilities</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section certificate-section">
    <div class="container certificate-panel">
      <div>
        <p class="eyebrow">Certification</p>
        <h2>NABL certificate extracts at a glance.</h2>
        <p>Certificate <strong><%= certificateNumber %></strong>, issued <%= issueDate %>, valid until <%= validUntil %>. Scope includes civil engineering material testing and site support.</p>
      </div>
      <a class="btn btn-primary" href="/accreditation">View Extracts</a>
    </div>
  </section>
</main>
<%- include("partials/footer") %>
