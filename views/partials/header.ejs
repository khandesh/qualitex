<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="NABL accredited testing laboratory in Sambhajinagar." />
  <title>
    <%= pageTitle %> | <%= labName %>
  </title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@400;500;700;800;900&display=swap"
    rel="stylesheet" />
  <link rel="stylesheet" href="/css/styles.css" />
</head>

<body>
  <header class="topbar">
    <div class="container">
      <p>NABL TC-16872 | ISO/IEC 17025:2017 | Valid Until <%= validUntil %>
      </p>
      <div class="topbar-contact">
        <a href="https://wa.me/<%= whatsappNumber.replace(/\D/g, '') %>" target="_blank" rel="noopener">
          WhatsApp: <%= whatsappNumber %>
        </a>
      </div>
    </div>
  </header>
  <nav class="navbar">
    <div class="container nav-wrap">
      <a class="brand" href="/">
        <span class="brand-mark">Q</span>
        <span>Qualitex Sambhajinagar</span>
      </a>
      <button id="menuBtn" class="menu-btn" aria-label="Open navigation">☰</button>
      <ul id="menu" class="menu">
        <li><a href="/" class="<%= pageTitle === 'Home' ? 'active' : '' %>">Home</a></li>
        <li><a href="/about.html" class="<%= pageTitle === 'About' ? 'active' : '' %>">About</a></li>
        <li><a href="/services.html" class="<%= pageTitle === 'Services' ? 'active' : '' %>">Services</a></li>
        <li><a href="/accreditation.html" class="<%= pageTitle === 'Accreditation' ? 'active' : '' %>">Accreditation</a>
        </li>
        <li><a href="/contact.html" class="<%= pageTitle === 'Contact' ? 'active' : '' %>">Contact</a></li>
      </ul>
    </div>
  </nav>