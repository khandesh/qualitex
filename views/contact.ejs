<%- include("partials/header") %>
<main>
  <section class="page-hero">
    <div class="container page-intro">
      <p class="eyebrow">Contact</p>
      <h1>Send a testing requirement or schedule sample collection.</h1>
      <p>Share the material, project location, standards, and timeline. The team can coordinate lab testing, site visits, and documentation requirements.</p>
    </div>
  </section>

  <section class="section">
    <div class="container split-layout">
      <div class="panel">
        <h3>Laboratory address</h3>
        <p><%= location %></p>
        <h3>Email</h3>
        <p>info@qualitexsambhajinagar.in</p>
        <h3>Accreditation</h3>
        <p><%= certificateNumber %> | ISO/IEC 17025:2017</p>
      </div>
      <form method="post" action="/contact" class="panel form">
        <label>Name<input type="text" name="name" required /></label>
        <label>Contact<input type="tel" name="contact" required /></label>
        <label>Email<input type="email" name="email" required /></label>
        <label>Message<textarea name="message" rows="5" required></textarea></label>
        <button class="btn btn-primary" type="submit">Submit Requirement</button>
        <% if (sent) { %>
          <p class="ok">Thank you, <%= (formData && formData.name) || "Client" %>. We received your request.</p>
        <% } %>
      </form>
    </div>
  </section>
</main>
<%- include("partials/footer") %>
